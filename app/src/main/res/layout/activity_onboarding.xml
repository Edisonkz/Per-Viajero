<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingGradientRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_emerald">

    <!-- Orbes luminosos ambientales para profundidad cinemática -->
    <View
        android:id="@+id/viewOnboardingOrbTop"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-110dp"
        android:background="@drawable/bg_onboarding_orb" />

    <View
        android:id="@+id/viewOnboardingOrbBottom"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-100dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_onboarding_orb" />

    <!-- Contenido principal con insets seguros -->
    <LinearLayout
        android:id="@+id/layoutOnboardingContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabecera Superior: Logo oficial, Marca y Botón Omitir -->
        <LinearLayout
            android:id="@+id/layoutOnboardingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_peruviajero_agency" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOnboardingStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paso 1 de 4"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnboardingSaltar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#20FFFFFF"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Omitir"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <!-- ViewPager2 con transición Parallax y Depth -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerOnboarding"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- Zona Inferior Interactiva -->
        <LinearLayout
            android:id="@+id/layoutOnboardingFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="22dp">

            <!-- Indicador animado de páginas -->
            <LinearLayout
                android:id="@+id/layoutIndicadorPuntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Botón Principal CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnboardingAccion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="6dp"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:textColor="#004D25"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <!-- Enlace secundario rápido a Login en la diapositiva final -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnboardingLogin"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:text="¿Ya tienes cuenta? Iniciar Sesión"
                android:textAllCaps="false"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Turismo Formal Certificado • MINCETUR Perú"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
