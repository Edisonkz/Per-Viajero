<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:openDrawer="start">

    <!-- Contenido principal -->
    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar superior con hamburguesa y acciones rápidas -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimary"
                app:elevation="4dp"
                app:navigationIconTint="#FFFFFF"
                app:title="@string/app_name"
                app:titleTextColor="#FFFFFF" />

            <!-- Contenedor de Fragments (deja espacio abajo para la barra plana de 64dp) -->
            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="64dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Barra inferior curva de 5 menús con media luna central elevada -->
        <FrameLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="10dp">

            <pe.edu.utp.perviajero.ui.view.CurvedBottomBarBgView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Contenedor interno fijo de 84dp sobre el paddingBottom de navegación del sistema -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Fila de 5 columnas inferiores -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_gravity="bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <!-- Tab 1: Explorar -->
                    <LinearLayout
                        android:id="@+id/navTabExplorar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivNavExplorar"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_explore_mountain"
                            android:contentDescription="Explorar" />

                        <TextView
                            android:id="@+id/tvNavExplorar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Explorar"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Tab 2: Comunidad -->
                    <LinearLayout
                        android:id="@+id/navTabComunidad"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivNavComunidad"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_community"
                            android:contentDescription="Comunidad" />

                        <TextView
                            android:id="@+id/tvNavComunidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Comunidad"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Tab 3 (Centro): Etiqueta de Mis Reservas / Agencia -->
                    <LinearLayout
                        android:id="@+id/navTabReservasLabelArea"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tvNavReservas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis Reservas"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Tab 4: Itinerario -->
                    <LinearLayout
                        android:id="@+id/navTabItinerario"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivNavItinerario"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_calendar"
                            android:contentDescription="Itinerario" />

                        <TextView
                            android:id="@+id/tvNavItinerario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Itinerario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Tab 5: Favoritos -->
                    <LinearLayout
                        android:id="@+id/navTabFavoritos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivNavFavoritos"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_favoritos_border"
                            android:contentDescription="Favoritos" />

                        <TextView
                            android:id="@+id/tvNavFavoritos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Favoritos"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Botón circular central elevado en la media luna (Mis Reservas / Agencia) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNavCenterReservas"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#FFFFFFFF"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/ivNavCenterReservas"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_receipt"
                        app:tint="#FFFFFF"
                        android:contentDescription="Mis Reservas" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Menú Lateral Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorCardBackground"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="@color/colorTextPrimary"
        app:itemTextColor="@color/colorTextPrimary"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
