<?xml version="1.0" encoding="utf-8"?>
<!-- Boleto Oficial de Embarque fiel al mockup 09_ver_boleto_voucher.jpg -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Tarjeta Boarding Pass Perforada -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <pe.edu.utp.perviajero.ui.view.BoardingPassBgView
                android:id="@+id/boardingPassVoucherBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Cabecera Esmeralda Fiscal MINCETUR + Badge CONFIRMADA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorPrimary"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTicketEmpresa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PerúViajero Tours S.A.C."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTicketRuc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="RUC: 20608945123 • Reg. MINCETUR"
                            android:textColor="#D9FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTicketEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_white_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/colorAccent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="CONFIRMADA" />
                </LinearLayout>

                <!-- Cuerpo Superior del Boleto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp">

                    <!-- Miniatura Destino + Nombre + Código PV + Fecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivTicketFoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Destino"
                                android:scaleType="centerCrop"
                                tools:src="@tools:sample/backgrounds/scenic" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTicketDestino"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Machu Picchu" />

                            <TextView
                                android:id="@+id/tvTicketCodigo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_pill_soft"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/colorPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="PV-2026-8492" />

                            <TextView
                                android:id="@+id/tvTicketFechaHora"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp"
                                tools:text="22/11/2026 • 06:00 AM" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Grilla 2x2: Embarque / Transporte / Guía / Pasajeros -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Embarque"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTicketTerminal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Terminal Wanchaq" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Transporte"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTicketTransporte"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Van Turística" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Guía Oficial"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTicketGuia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Guía Bilingüe" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pasajeros"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTicketCantidadPasajeros"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="2 Pasajeros" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Caja Manifiesto de Pasajeros -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_soft"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manifiesto de Pasajeros"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTicketPasajerosLista"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            tools:text="• Kevin Turista (DNI: 72481920)\n• María López (DNI: 71849302)" />
                    </LinearLayout>

                    <!-- Espacio para la línea punteada y muescas laterales -->
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="24dp" />

                    <!-- Talón inferior: Código QR + Total Pagado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <pe.edu.utp.perviajero.ui.view.QrVisualView
                            android:id="@+id/qrTicketVoucher"
                            android:layout_width="96dp"
                            android:layout_height="96dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Pagado"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvTicketTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/colorPrimary"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="S/ 420.00" />

                            <TextView
                                android:id="@+id/tvTicketMetodoPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                tools:text="Inc. IGV • Tarjeta" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Botones inferiores: Ver en Mapa | Compartir Boleto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTicketMaps"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Ver en Mapa"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_location"
                app:iconSize="16dp"
                app:iconTint="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTicketCompartir"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Compartir Boleto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_share"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
