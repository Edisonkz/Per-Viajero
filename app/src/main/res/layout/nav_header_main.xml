<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Fondo verde con curva envolvente superior derecha -->
    <pe.edu.utp.perviajero.ui.view.DrawerHeaderBgView
        android:id="@+id/drawerHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/drawerHeaderContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="38dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivDrawerAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_white_badge"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            android:contentDescription="Avatar de usuario" />

        <TextView
            android:id="@+id/tvDrawerNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Kevin Turista" />

        <TextView
            android:id="@+id/tvDrawerEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E0FFFFFF"
            android:textSize="13sp"
            tools:text="kevin@peruviajero.pe" />

        <TextView
            android:id="@+id/tvDrawerRolBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_white_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="@color/colorAccent"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="TURISTA" />

    </LinearLayout>

</FrameLayout>
