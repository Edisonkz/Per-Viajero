<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetallePub"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="#FFFFFF"
        app:title="Experiencia de Viajero"
        app:titleTextColor="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetallePub"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Carrusel Multi-Foto con contador y puntos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:background="#111111">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpDetallePubFotos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvDetallePubFotoCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_onboarding_glass_pill"
                    android:backgroundTint="#99000000"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="1 / 3"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layoutDetallePubDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </FrameLayout>

            <!-- Cabecera del autor + destino + rating -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivDetallePubAvatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pill_soft"
                        android:contentDescription="Avatar viajero"
                        android:padding="6dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetallePubAutor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Camila Mendoza" />

                        <TextView
                            android:id="@+id/tvDetallePubMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            tools:text="Cusco • 12/11/2026" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetallePubRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_amber_soft"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="5.0 ★" />
                </LinearLayout>

                <!-- Chip Destino -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetallePubDestino"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_location"
                    app:iconSize="16dp"
                    app:iconTint="@color/colorPrimary"
                    tools:text="Santuario Histórico de Machu Picchu" />

                <!-- Relato completo -->
                <TextView
                    android:id="@+id/tvDetallePubTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="Subir en el primer bus de las 5:30 a. m. vale totalmente la pena..." />

                <!-- Barra de acciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetallePubLike"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="24 Útil"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_thumb_up"
                        app:iconSize="16dp" />

                    <TextView
                        android:id="@+id/tvDetallePubCountComentarios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2 comentarios" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetallePubModerar"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Eliminar"
                        android:textAllCaps="false"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#1A000000" />

                <!-- Sección de Comentarios -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Comentarios de Viajeros"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetallePubSinComentarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_soft"
                    android:gravity="center"
                    android:padding="18dp"
                    android:text="Aún no hay comentarios. ¡Sé el primero en opinar o preguntar sobre este destino!"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDetallePubComentarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior fija para redactar comentario -->
    <LinearLayout
        android:id="@+id/layoutBarraComentar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorCardBackground"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/etDetallePubComentario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_soft"
            android:hint="Escribe un comentario..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:minHeight="44dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetallePubEnviar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/colorPrimary"
            android:minWidth="0dp"
            android:paddingHorizontal="18dp"
            android:text="Enviar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="22dp" />
    </LinearLayout>

</LinearLayout>
